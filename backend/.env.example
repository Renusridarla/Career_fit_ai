# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
JWT_SECRET=super_secret_careerfit_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
