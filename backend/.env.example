AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# CORS Settings
FRONTEND_URL=http://localhost:5173
